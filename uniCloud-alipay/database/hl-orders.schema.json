{
  "bsonType": "object",
  "permission": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  },
  "required": [
    "customerId",
    "orderNo",
    "status",
    "createdAt"
  ],
  "properties": {
    "proofExpiresAt": { "bsonType": "long" },
    "proofDeletedAt": { "bsonType": "long" },
    "customerId": {
      "bsonType": "string"
    },
    "orderNo": {
      "bsonType": "string"
    },
    "status": {
      "bsonType": "string",
      "enum": [
        "pending",
        "processing",
        "paid",
        "rejected"
      ]
    },
    "amount": {
      "bsonType": "int",
      "minimum": 0
    },
    "payout": {
      "bsonType": "int",
      "minimum": 0
    },
    "owner": {
      "bsonType": "string"
    },
    "ownerName": {
      "bsonType": "string"
    },
    "note": {
      "bsonType": "string"
    },
    "createdAt": {
      "bsonType": "long"
    },
    "updatedAt": {
      "bsonType": "long"
    },
    "paidAt": {
      "bsonType": "long"
    }
  }
}
